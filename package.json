{
  "displayName": "Homebridge Eufy",
  "name": "@homebridge-plugins/homebridge-eufy-security",
  "version": "5.0.0-beta.0",
  "description": "Control Eufy Security from homebridge.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-eufy.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/lenoxys"
    }
  ],
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-eufy/issues"
  },
  "engines": {
    "node": ">=24.5.0",
    "homebridge": "^2.4.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "lint-fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "guard:no-ecs": "bash scripts/guard-no-ecs.sh",
    "qualify:release": "node scripts/qualify-release.mjs",
    "test": "vitest run",
    "verify": "npm run lint && npm run guard:no-ecs && npm run build && npm test",
    "prepublishOnly": "npm run build && npm run qualify:release && npm run verify"
  },
  "keywords": [
    "homebridge-plugin",
    "Eufy",
    "Eufy Security",
    "doorbell",
    "eufy doorbell",
    "security-system",
    "camera"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mega-yfue/eufy-sdk": "0.5.0-beta.92",
    "ffmpeg-for-homebridge": "2.2.2"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "2.2.3",
    "@types/node": "^26.6.4",
    "homebridge": "^2.4.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://homebridge-plugins.github.io/homebridge-eufy/",
  "author": "homebridge-eufy",
  "allowScripts": {
    "ffmpeg-for-homebridge@2.2.2": true
  },
  "optionalDependencies": {
    "node-datachannel": "0.33.4"
  }
}
